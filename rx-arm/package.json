{
  "name": "armgov-rx-leader-cover",
  "version": "1.0.0",
  "description": "АРМ руководителя (обзор поручений) для обложки Directum RX-веб как сторонний контрол: Remote Component, Module Federation, scope Cover. Один контрол — весь экран MVP 1-го этапа.",
  "author": "ARMGov",
  "license": "MIT",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build:release": "webpack --mode production --progress=profile",
    "build:dev:standalone": "webpack --mode development --progress=profile --env mode=standalone",
    "build:dev:remote": "webpack --mode development --progress=profile",
    "serve": "serve dist -p 3003",
    "start:dev:standalone": "concurrently \"webpack --mode development --progress=profile --env mode=standalone --watch\" \"npm run serve\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@babel/core": "7.21.4",
    "@babel/preset-react": "7.18.6",
    "@babel/preset-typescript": "7.21.4",
    "@directum/sungero-remote-component-metadata-plugin": "1.0.1",
    "@directum/sungero-remote-component-types": "1.0.1",
    "@types/node": "20.4.9",
    "@types/react": "18.2.21",
    "@types/react-dom": "18.2.7",
    "babel-loader": "9.1.2",
    "concurrently": "8.2.1",
    "css-loader": "6.7.3",
    "css-minimizer-webpack-plugin": "5.0.1",
    "html-webpack-plugin": "5.5.1",
    "mini-css-extract-plugin": "2.7.6",
    "serve": "14.2.0",
    "style-loader": "3.3.2",
    "terser-webpack-plugin": "5.3.9",
    "typescript": "4.9.4",
    "webpack": "5.80.0",
    "webpack-cli": "5.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
