{
  "name": "armgov-rx-leader-cover",
  "version": "1.0.0",
  "description": "АРМ руководителя (обзор поручений) для обложки Directum RX-веб как сторонний контрол: Remote Component, Module Federation, scope Cover. Один контрол — весь экран MVP 1-го этапа.",
  "author": "ARMGov",
  "license": "MIT",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build:release": "webpack --mode production --progress=profile",
    "build:dev:standalone": "webpack --mode development --progress=profile --env mode=standalone",
    "build:dev:remote": "webpack --mode development --progress=profile",
    "serve": "serve dist -p 3003",
    "start:dev:standalone": "concurrently \"webpack --mode development --progress=profile --env mode=standalone --watch\" \"npm run serve\"",
    "start:dev:remote": "webpack --mode development --progress=profile --watch",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "prettier:check": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "format": "npm run prettier:fix && npm run lint:fix",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build:dev:remote",
    "check:full": "npm run prettier:check && npm run typecheck && npm run lint && npm run test && npm run build:release"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@directum/sungero-remote-component-metadata-plugin": "1.0.1",
    "@directum/sungero-remote-component-types": "1.0.1",
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "@types/node": "20.4.9",
    "@types/react": "18.2.21",
    "@types/react-dom": "18.2.7",
    "babel-jest": "^29.7.0",
    "babel-loader": "9.1.2",
    "concurrently": "8.2.1",
    "css-loader": "6.7.3",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-check-file": "^2.8.0",
    "eslint-plugin-css-modules": "^2.12.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unicorn": "^48.0.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "html-webpack-plugin": "5.5.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "2.7.6",
    "prettier": "^3.9.3",
    "serve": "^14.2.6",
    "style-loader": "3.3.2",
    "terser-webpack-plugin": "^5.3.17",
    "typescript": "4.9.4",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.108.0",
    "webpack-cli": "5.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
